{
  "name": "redisflow-mvp",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Laboratório didático de filas com PostgreSQL e Redis",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "test": "node --import tsx --test testes/*.test.ts",
    "test:integracao": "node --import tsx testes/integracao/filas.test.ts"
  },
  "dependencies": {
    "next": "16.2.11",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "pg": "8.20.0",
    "redis": "^5.8.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/pg": "8.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
